{
  "resource_name": "Parlant AI Agent Framework",
  "resource_type": "ai_framework",
  "version": "3.0.2",
  "description": "An open-source Agentic Behavior Modeling Engine for building reliable, compliant AI agents with ensured rule-following behavior",
  "repository": {
    "type": "git",
    "url": "https://github.com/AureliustechandTalentSolutions/parlant",
    "branch": "develop"
  },
  "license": {
    "type": "Apache-2.0",
    "url": "https://github.com/AureliustechandTalentSolutions/parlant/blob/develop/LICENSE",
    "federal_friendly": true
  },
  "platform_compatibility": {
    "language": "Python",
    "minimum_version": "3.10",
    "supported_platforms": ["linux", "macos", "windows"],
    "architecture": ["x86_64", "arm64"],
    "deployment_types": ["standalone", "docker", "kubernetes"]
  },
  "federal_compliance": {
    "fedramp": {
      "status": "in_progress",
      "target_level": "moderate"
    },
    "fisma": {
      "status": "compatible",
      "documentation": "docs/integrations/aurelius-federal-platform.md"
    },
    "section_508": {
      "status": "compliant",
      "wcag_level": "AA"
    },
    "nist": {
      "frameworks": ["AI RMF", "Cybersecurity Framework"],
      "status": "aligned"
    }
  },
  "security": {
    "authentication": {
      "supported_methods": ["api_key", "oauth2", "custom_policy"],
      "cac_piv_ready": true
    },
    "encryption": {
      "at_rest": true,
      "in_transit": true,
      "tls_version": "1.3"
    },
    "audit_logging": {
      "enabled": true,
      "retention_configurable": true,
      "siem_compatible": true
    },
    "data_residency": {
      "on_premises": true,
      "cloud_options": ["aws_govcloud", "azure_government", "private_cloud"]
    }
  },
  "categories": [
    "artificial-intelligence",
    "conversational-ai",
    "agent-framework",
    "nlp",
    "machine-learning",
    "enterprise-software"
  ],
  "tags": [
    "ai",
    "agents",
    "llm",
    "conversational-ai",
    "federal",
    "compliance",
    "behavioral-modeling",
    "guidelines",
    "explainable-ai",
    "python",
    "rest-api"
  ],
  "use_cases": [
    "customer_service",
    "citizen_engagement",
    "benefits_assistance",
    "information_retrieval",
    "compliance_enforcement",
    "process_automation"
  ],
  "integration": {
    "apis": {
      "rest_api": true,
      "api_documentation": "https://parlant.io/docs/api"
    },
    "sdks": [
      {
        "language": "python",
        "package": "parlant-client",
        "repository": "https://github.com/emcie-co/parlant-client-python"
      },
      {
        "language": "typescript",
        "package": "parlant-client",
        "npm_package": "parlant-client"
      }
    ],
    "llm_providers": [
      {
        "name": "OpenAI",
        "supported": true,
        "federal_option": false
      },
      {
        "name": "Azure OpenAI",
        "supported": true,
        "federal_option": true,
        "govcloud": true
      },
      {
        "name": "AWS Bedrock",
        "supported": true,
        "federal_option": true,
        "govcloud": true,
        "fedramp": true
      },
      {
        "name": "Google Vertex AI",
        "supported": true,
        "federal_option": false
      },
      {
        "name": "Anthropic",
        "supported": true,
        "federal_option": false
      }
    ],
    "databases": [
      {
        "name": "SQLite",
        "default": true,
        "production_ready": false
      },
      {
        "name": "PostgreSQL",
        "supported": true,
        "production_ready": true,
        "recommended": true
      },
      {
        "name": "MongoDB",
        "supported": true,
        "production_ready": true
      }
    ]
  },
  "features": {
    "behavioral_guidelines": {
      "description": "Define and enforce agent behavior rules",
      "compliance_ready": true
    },
    "journey_management": {
      "description": "Guide conversations through defined steps",
      "workflow_support": true
    },
    "tool_integration": {
      "description": "Connect to external APIs and services",
      "custom_tools": true
    },
    "explainability": {
      "description": "Understand agent decision-making process",
      "audit_trail": true
    },
    "canned_responses": {
      "description": "Predefined responses for consistency",
      "template_support": true
    },
    "context_variables": {
      "description": "Dynamic context management",
      "real_time_updates": true
    },
    "glossary_management": {
      "description": "Domain-specific terminology",
      "customizable": true
    }
  },
  "requirements": {
    "runtime": {
      "python": ">=3.10",
      "memory_minimum": "512MB",
      "memory_recommended": "2GB",
      "cpu_minimum": "1 core",
      "cpu_recommended": "2 cores",
      "storage": "1GB"
    },
    "dependencies": {
      "core": [
        "fastapi",
        "uvicorn",
        "lagom",
        "openai",
        "httpx",
        "click"
      ],
      "optional": [
        "anthropic",
        "google-genai",
        "torch",
        "transformers",
        "litellm",
        "pymongo"
      ]
    }
  },
  "installation": {
    "pip": "pip install parlant",
    "docker": "docker pull parlant/parlant:latest",
    "source": "git clone https://github.com/AureliustechandTalentSolutions/parlant.git",
    "extras": {
      "aws": "pip install parlant[aws]",
      "azure": "pip install parlant[azure]",
      "vertex": "pip install parlant[vertex]",
      "anthropic": "pip install parlant[anthropic]"
    }
  },
  "documentation": {
    "main": "https://parlant.io/docs",
    "quickstart": "https://parlant.io/docs/quickstart/installation",
    "api_reference": "https://parlant.io/docs/api",
    "integration_guide": "docs/integrations/aurelius-federal-platform.md",
    "examples": "https://github.com/AureliustechandTalentSolutions/parlant/tree/develop/examples"
  },
  "support": {
    "github_issues": "https://github.com/AureliustechandTalentSolutions/parlant/issues",
    "community_discord": "https://discord.gg/duxWqxKk6J",
    "email": "support@parlant.io",
    "federal_support": "federal-support@parlant.io"
  },
  "testing": {
    "test_suite": true,
    "test_framework": "pytest",
    "coverage": "extensive",
    "ci_cd": true
  },
  "maintenance": {
    "status": "active",
    "update_frequency": "regular",
    "lts_support": false,
    "security_patches": true
  },
  "metadata": {
    "added_to_library": "2025-01-XX",
    "last_updated": "2025-01-XX",
    "maintainer": "Emcie Co Ltd",
    "verified": false,
    "featured": false
  }
}
